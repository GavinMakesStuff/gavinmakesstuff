{
  "name": "media-organizer",
  "version": "0.1.0",
  "description": "Windows desktop app to find duplicate photos/videos/audio, keep the highest-quality copy of each, and apply Gavin's naming conventions.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.gavinmakesstuff.mediaorganizer",
    "productName": "Media Organizer",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8"
  }
}
