{
  "outputDirectory": ".",
  "functions": {
    "api/seo-tools.js": { "includeFiles": "{data/blog.json,studio/blog-post-shell.html}" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/studio/blog-post.html", "destination": "/api/seo-tools?action=blog-post" },
    { "source": "/sitemap.xml", "destination": "/api/seo-tools?action=sitemap" },
    { "source": "/anami", "destination": "https://anami-nu.vercel.app/anami" },
    { "source": "/anami/:path*", "destination": "https://anami-nu.vercel.app/anami/:path*" }
  ],
  "crons": [
    { "path": "/api/seo-tools?action=cron-report", "schedule": "0 9 1 * *" }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/scout/app.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/studio/blog-post-shell.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/scout/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}